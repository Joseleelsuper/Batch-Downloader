# ==============================================================================
# Batch Downloader - desarrollo local y despliegue Docker con GHCR
# Copia este archivo a .env antes de ejecutar Docker Compose.
# Para desarrollo: `docker compose --env-file .env up --build`.
# Para GHCR: `docker compose --env-file .env -f compose.ghcr.yml up -d`.
# Los compose y application.properties no tienen fallbacks: todas estas claves son obligatorias.
# En produccion cambia todos los secretos marcados como *_PASSWORD o *_SECRET.
# ==============================================================================


# ------------------------------------------------------------------------------
# GitHub Container Registry - imagenes publicadas desde main
# ------------------------------------------------------------------------------
GHCR_REGISTRY=ghcr.io
GHCR_OWNER=joseleelsuper
GHCR_IMAGE_PREFIX=batch-downloader
GHCR_IMAGE_TAG=main


# ------------------------------------------------------------------------------
# MySQL - fuente transaccional principal
# ------------------------------------------------------------------------------
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=batch_downloader
MYSQL_USER=batch_downloader
MYSQL_PASSWORD=batch_downloader
MYSQL_HOST_PORT=3306


# ------------------------------------------------------------------------------
# PostgreSQL + pgvector - almacenamiento semantico derivado
# ------------------------------------------------------------------------------
POSTGRES_DB=batch_downloader_semantic
POSTGRES_USER=batch_downloader
POSTGRES_PASSWORD=batch_downloader
POSTGRES_HOST_PORT=5432


# ------------------------------------------------------------------------------
# RabbitMQ - mensajeria entre servicios
# ------------------------------------------------------------------------------
RABBITMQ_DEFAULT_USER=batch_downloader
RABBITMQ_DEFAULT_PASS=batch_downloader
RABBITMQ_HOST_PORT=5672
RABBITMQ_MANAGEMENT_HOST_PORT=15672
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_COMMAND_EXCHANGE=batch.commands.v1
RABBITMQ_EVENT_EXCHANGE=batch.events.v1
SCRAPPER_INTERNAL_SERVICE_TOKEN=replace-with-a-long-random-internal-token


# ------------------------------------------------------------------------------
# MinIO - instaladores, ZIPs y manifiestos temporales
# ------------------------------------------------------------------------------
MINIO_ROOT_USER=batch_downloader
MINIO_ROOT_PASSWORD=batch_downloader_secret
MINIO_API_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001
MINIO_ENDPOINT=http://minio:9000
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
MINIO_ZIP_BUCKET=zips
MINIO_REGION=us-east-1


# ------------------------------------------------------------------------------
# Scraper API - FastAPI en api/scraper
# ------------------------------------------------------------------------------
SCRAPPER_APP_NAME=Batch Downloader Scraper
SCRAPPER_ENVIRONMENT=development
SCRAPPER_URL_PROTECTION_SECRET=replace-with-a-long-random-secret
SCRAPPER_WINSTALL_BASE_URL=https://winstall.app
SCRAPPER_WINSTALL_API_BASE_URL=https://winstall.app/api/winstall
SCRAPPER_REQUEST_TIMEOUT_SECONDS=20
SCRAPPER_MAX_REDIRECTS=5
SCRAPPER_MAX_DOWNLOAD_SIZE_BYTES=1500000000
SCRAPPER_ICON_MAX_BYTES=5000000
SCRAPPER_SO_FILTER_CONCURRENCY=2
SCRAPPER_SO_FILTER_MAX_ATTEMPTS=4
SCRAPPER_SCRAPE_CONCURRENCY=6
SCRAPPER_CPU_THREAD_WORKERS=4
SCRAPPER_SCHEDULER_TIMEZONE=Europe/Madrid
SCRAPPER_SCHEDULER_HOUR=3
SCRAPPER_SCHEDULER_MINUTE=0
SCRAPPER_RUN_ON_STARTUP=true
SCRAPPER_ALLOWED_DOWNLOAD_SCHEMES=["https"]
SCRAPPER_SCRAPE_MAX_APPS=0
SCRAPPER_SCRAPE_APP_TIMEOUT_SECONDS=90
SCRAPPER_PLAYWRIGHT_TIMEOUT_MS=15000
SCRAPPER_API_HOST_PORT=8000
SCRAPPER_LLM_GROQ_API_KEY=
SCRAPPER_LLM_GROQ_BASE_URL=https://api.groq.com/openai/v1
SCRAPPER_LLM_GROQ_MODEL=llama-3.1-8b-instant
SCRAPPER_LLM_GROQ_FALLBACK_MODELS=["llama-3.3-70b-versatile","qwen/qwen3-32b","qwen/qwen3.6-27b","meta-llama/llama-4-scout-17b-16e-instruct"]
SCRAPPER_LLM_DEEPSEEK_API_KEY=
SCRAPPER_LLM_DEEPSEEK_BASE_URL=https://api.deepseek.com
SCRAPPER_LLM_DEEPSEEK_MODEL=deepseek-v4-flash
SCRAPPER_LLM_MAX_CONCURRENCY=1
SCRAPPER_LLM_MAX_APPS_PER_RUN=0
SCRAPPER_LLM_REQUEST_TIMEOUT_SECONDS=45


# ------------------------------------------------------------------------------
# WebApp - React/Vite servido por Nginx
# ------------------------------------------------------------------------------
WEBAPP_HOST_PORT=3000


# ------------------------------------------------------------------------------
# Core API - Spring Boot principal futuro
# ------------------------------------------------------------------------------
CORE_API_SERVER_PORT=8080
CORE_API_HOST_PORT=8081
CORE_API_SCRAPER_API_URL=http://scraper-api:8000
CORE_API_SEMANTIC_SERVICE_URL=http://semantic-service:8000
CORE_API_SEMANTIC_REQUEST_TIMEOUT=3s
CORE_API_SEMANTIC_ADMIN_REQUEST_TIMEOUT=30s
CORE_API_ADMIN_USERNAME=admin
CORE_API_ADMIN_EMAIL=admin@batch-downloader.local
# Generar otro hash: docker run --rm httpd:2.4-alpine htpasswd -nbB -C 12 admin TU_PASSWORD
# El valor siguiente corresponde a la contrasena local de ejemplo: admin
CORE_API_ADMIN_PASSWORD_HASH='$2y$12$bHJ7N8sdERYVjI0O7iG6auEi3LPGXk7zy.Nz.7KjueEnjZfnMPWEy'
CORE_API_BCRYPT_STRENGTH=12
CORE_API_SESSION_TIMEOUT=8h
CORE_API_VERIFICATION_TTL=24h
CORE_API_PASSWORD_RESET_TTL=1h
CORE_API_OUTBOX_DELAY=1s
CORE_API_JWT_SECRET=replace-with-a-long-random-jwt-secret
CORE_API_JWT_TTL_SECONDS=28800
CORE_API_REQUIRE_HTTPS=false
CORE_API_COOKIE_SECURE=false
CORE_API_DOWNLOAD_OWNER_SECRET=replace-with-a-long-random-download-owner-secret
DOWNLOAD_MAX_APPS=100
DOWNLOAD_ZIP_RETENTION=24h
DOWNLOAD_PRESIGNED_URL_TTL=5m
DOWNLOAD_ANONYMOUS_MAX_ACTIVE_JOBS=2
DOWNLOAD_ANONYMOUS_MAX_CREATES_PER_HOUR=10
DOWNLOAD_ANONYMOUS_MAX_CREATES_PER_IP_HOUR=30
CORE_API_DOWNLOAD_EVENTS_QUEUE=core-api.download.events.v1


# ------------------------------------------------------------------------------
# Semantic Service - FastAPI para busqueda semantica
# ------------------------------------------------------------------------------
SEMANTIC_SERVICE_HOST_PORT=8001
SEMANTIC_DEVICE=cpu
SEMANTIC_TRAINER_DEVICE=cpu
SEMANTIC_INITIAL_MODEL_VERSION=multilingual-e5-base@d128750597153bb5987e10b1c3493a34e5a4502a:zero-shot
SEMANTIC_CANDIDATE_LIMIT=20000
SEMANTIC_MINIMUM_SIMILARITY=0.82
SEMANTIC_INDEX_BATCH_SIZE=32
SEMANTIC_INDEX_INTERVAL_SECONDS=300
SEMANTIC_INDEX_LEASE_SECONDS=900
SEMANTIC_SEARCH_TIMEOUT_SECONDS=3
SEMANTIC_OPERATION_POLL_SECONDS=2
SEMANTIC_OPERATION_LEASE_SECONDS=300
SEMANTIC_MODEL_MAX_BYTES=16106127360
SEMANTIC_MODEL_MIN_FREE_BYTES=10737418240
SEMANTIC_TRAINER_SEED=20260723
SEMANTIC_TRAINER_EPOCHS=1
SEMANTIC_TRAINER_BATCH_SIZE=8
SEMANTIC_TRAINER_MAX_STEPS=-1
SEMANTIC_TRAINER_MODELS=["paraphrase-multilingual-MiniLM-L12-v2","multilingual-e5-base","bge-m3"]


# ------------------------------------------------------------------------------
# Notification Service - Spring Boot
# ------------------------------------------------------------------------------
NOTIFICATION_SERVICE_SERVER_PORT=8080
NOTIFICATION_SERVICE_HOST_PORT=8083
NOTIFICATION_RETRY_MAX_ATTEMPTS=3
NOTIFICATION_RETRY_INITIAL_INTERVAL=1s
NOTIFICATION_RETRY_MULTIPLIER=2
NOTIFICATION_RETRY_MAX_INTERVAL=10s
NOTIFICATION_SERVICE_INBOX_URL=jdbc:h2:file:/app/data/notification-inbox;DB_CLOSE_ON_EXIT=FALSE
NOTIFICATION_SERVICE_INBOX_USERNAME=sa
NOTIFICATION_SERVICE_INBOX_PASSWORD=
NOTIFICATION_SERVICE_INBOX_LEASE_DURATION=PT5M
NOTIFICATION_SERVICE_SMTP_HOST=mailpit
NOTIFICATION_SERVICE_SMTP_PORT=1025
NOTIFICATION_SERVICE_SMTP_USERNAME=
NOTIFICATION_SERVICE_SMTP_PASSWORD=
NOTIFICATION_SERVICE_SMTP_AUTH=false
NOTIFICATION_SERVICE_SMTP_STARTTLS=false
NOTIFICATION_SERVICE_SMTP_CONNECTION_TIMEOUT_MS=5000
NOTIFICATION_SERVICE_SMTP_TIMEOUT_MS=10000
NOTIFICATION_SERVICE_SMTP_WRITE_TIMEOUT_MS=10000
NOTIFICATION_SERVICE_MAIL_FROM=no-reply@batch-downloader.local
NOTIFICATION_SERVICE_MAIL_ZONE_ID=Europe/Madrid
NOTIFICATION_SERVICE_PUBLIC_BASE_URL=http://localhost:3000
MAILPIT_SMTP_HOST_PORT=1025
MAILPIT_UI_HOST_PORT=8025


# ------------------------------------------------------------------------------
# Download Worker - Spring Boot
# ------------------------------------------------------------------------------
DOWNLOAD_WORKER_SERVER_PORT=8080
DOWNLOAD_WORKER_HOST_PORT=8084
DOWNLOAD_WORKER_INBOX_URL=jdbc:h2:file:/app/data/download-inbox;DB_CLOSE_ON_EXIT=FALSE
DOWNLOAD_WORKER_INBOX_USERNAME=sa
DOWNLOAD_WORKER_INBOX_PASSWORD=
DOWNLOAD_WORKER_COMMAND_EXCHANGE=batch.commands.v1
DOWNLOAD_WORKER_EVENT_EXCHANGE=batch.events.v1
DOWNLOAD_WORKER_INPUT_ROUTING_KEY=download.job.requested
DOWNLOAD_WORKER_INPUT_QUEUE=download-worker.download.job.requested.v1
DOWNLOAD_WORKER_CANCELLATION_ROUTING_KEY=download.job.cancel-requested
DOWNLOAD_WORKER_SOURCE_RESOLVER_URL=http://scraper-api:8000
DOWNLOAD_WORKER_CANCELLATION_QUEUE=download-worker.download.job.cancel-requested.v1
DOWNLOAD_WORKER_DLX=batch.dead-letter.v1
DOWNLOAD_WORKER_DLQ=download-worker.download.job.requested.v1.dlq
DOWNLOAD_WORKER_RETRY_ATTEMPTS=3
DOWNLOAD_WORKER_RETRY_INITIAL_INTERVAL=1s
DOWNLOAD_WORKER_RETRY_MULTIPLIER=2.0
DOWNLOAD_WORKER_RETRY_MAX_INTERVAL=10s
DOWNLOAD_WORKER_PRESIGNED_TTL=24h
DOWNLOAD_WORKER_SOURCE_RESOLVER_TIMEOUT=10s
DOWNLOAD_WORKER_MAX_ITEMS=100
DOWNLOAD_WORKER_MAX_FILE_SIZE=4GB
DOWNLOAD_WORKER_MAX_TOTAL_SIZE=20GB
DOWNLOAD_WORKER_MAX_REDIRECTS=5
DOWNLOAD_WORKER_CONNECT_TIMEOUT=10s
DOWNLOAD_WORKER_REQUEST_TIMEOUT=15m
DOWNLOAD_WORKER_CONCURRENCY=8
DOWNLOAD_WORKER_INBOX_LEASE=30m
DOWNLOAD_WORKER_TEMP_DIRECTORY=/tmp/batch-downloader


# ------------------------------------------------------------------------------
# Translation Service - Spring Boot + locales JSON
# ------------------------------------------------------------------------------
TRANSLATION_SERVICE_SERVER_PORT=8080
TRANSLATION_SERVICE_HOST_PORT=8085
TRANSLATION_SERVICE_LOCALES_PATH=/app/locales
TRANSLATION_SERVICE_CACHE_MAX_AGE=PT1H

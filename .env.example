# ==============================================================================
# Batch Downloader - desarrollo local y despliegue Docker con GHCR
# Copia este archivo a .env antes de ejecutar Docker Compose.
# Para desarrollo: `docker compose --env-file .env up --build`.
# Para GHCR: `docker compose --env-file .env -f compose.ghcr.yml up -d`.
# Los compose y application.properties no tienen fallbacks: todas estas claves son obligatorias.
# En produccion cambia todos los secretos marcados como *_PASSWORD o *_SECRET.
# ==============================================================================


# ------------------------------------------------------------------------------
# GitHub Container Registry - imagenes publicadas desde main
# ------------------------------------------------------------------------------
GHCR_REGISTRY=ghcr.io
GHCR_OWNER=joseleelsuper
GHCR_IMAGE_PREFIX=batch-downloader
GHCR_IMAGE_TAG=main


# ------------------------------------------------------------------------------
# MySQL - fuente transaccional principal
# ------------------------------------------------------------------------------
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=batch_downloader
MYSQL_USER=batch_downloader
MYSQL_PASSWORD=batch_downloader
MYSQL_HOST_PORT=3306


# ------------------------------------------------------------------------------
# PostgreSQL + pgvector - almacenamiento semantico derivado
# ------------------------------------------------------------------------------
POSTGRES_DB=batch_downloader_semantic
POSTGRES_USER=batch_downloader
POSTGRES_PASSWORD=batch_downloader
POSTGRES_HOST_PORT=5432


# ------------------------------------------------------------------------------
# RabbitMQ - mensajeria entre servicios
# ------------------------------------------------------------------------------
RABBITMQ_DEFAULT_USER=batch_downloader
RABBITMQ_DEFAULT_PASS=batch_downloader
RABBITMQ_HOST_PORT=5672
RABBITMQ_MANAGEMENT_HOST_PORT=15672
SCRAPPER_INTERNAL_SERVICE_TOKEN=replace-with-a-long-random-internal-token


# ------------------------------------------------------------------------------
# MinIO - instaladores, ZIPs y manifiestos temporales
# ------------------------------------------------------------------------------
MINIO_ROOT_USER=batch_downloader
MINIO_ROOT_PASSWORD=batch_downloader_secret
MINIO_API_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001


# ------------------------------------------------------------------------------
# Scraper API - FastAPI en api/scraper
# ------------------------------------------------------------------------------
SCRAPPER_APP_NAME=Batch Downloader Scraper
SCRAPPER_ENVIRONMENT=development
SCRAPPER_DOCKER_DATABASE_URL=mysql+asyncmy://batch_downloader:batch_downloader@mysql:3306/batch_downloader
SCRAPPER_DATABASE_URL=mysql+asyncmy://batch_downloader:batch_downloader@localhost:3306/batch_downloader
# Clave compartida con Core API para cifrar y leer las URLs resueltas almacenadas en MySQL.
SCRAPPER_URL_PROTECTION_SECRET=replace-with-a-long-random-secret
SCRAPPER_WINSTALL_BASE_URL=https://winstall.app
SCRAPPER_WINSTALL_API_BASE_URL=https://winstall.app/api/winstall
SCRAPPER_REQUEST_TIMEOUT_SECONDS=20
SCRAPPER_MAX_REDIRECTS=5
SCRAPPER_MAX_DOWNLOAD_SIZE_BYTES=1500000000
SCRAPPER_SCRAPE_CONCURRENCY=6
SCRAPPER_SCHEDULER_TIMEZONE=Europe/Madrid
SCRAPPER_SCHEDULER_HOUR=3
SCRAPPER_SCHEDULER_MINUTE=0
SCRAPPER_RUN_ON_STARTUP=true
SCRAPPER_ALLOWED_DOWNLOAD_SCHEMES=["https"]
SCRAPPER_SCRAPE_MAX_APPS=0
SCRAPPER_SCRAPE_APP_TIMEOUT_SECONDS=90
SCRAPPER_PLAYWRIGHT_TIMEOUT_MS=15000
SCRAPPER_API_HOST_PORT=8000
SCRAPPER_LLM_GROQ_API_KEY=
SCRAPPER_LLM_GROQ_BASE_URL=https://api.groq.com/openai/v1
SCRAPPER_LLM_GROQ_MODEL=llama-3.1-8b-instant
SCRAPPER_LLM_GROQ_FALLBACK_MODELS=["llama-3.3-70b-versatile","qwen/qwen3-32b","qwen/qwen3.6-27b","meta-llama/llama-4-scout-17b-16e-instruct"]
SCRAPPER_LLM_DEEPSEEK_API_KEY=
SCRAPPER_LLM_DEEPSEEK_BASE_URL=https://api.deepseek.com
SCRAPPER_LLM_DEEPSEEK_MODEL=deepseek-v4-flash
SCRAPPER_LLM_MAX_CONCURRENCY=1
SCRAPPER_LLM_MAX_APPS_PER_RUN=0
SCRAPPER_LLM_REQUEST_TIMEOUT_SECONDS=45


# ------------------------------------------------------------------------------
# WebApp - React/Vite servido por Nginx
# ------------------------------------------------------------------------------
WEBAPP_HOST_PORT=3000


# ------------------------------------------------------------------------------
# Core API - Spring Boot principal futuro
# ------------------------------------------------------------------------------
CORE_API_SERVER_PORT=8080
CORE_API_HOST_PORT=8081
CORE_API_MYSQL_URL=jdbc:mysql://mysql:3306/batch_downloader
CORE_API_MYSQL_USERNAME=batch_downloader
CORE_API_MYSQL_PASSWORD=batch_downloader
CORE_API_SCRAPPER_API_URL=http://scraper-api:8000
CORE_API_ADMIN_USERNAME=admin
# Generar otro hash: docker run --rm httpd:2.4-alpine htpasswd -nbB -C 12 admin TU_PASSWORD
# El valor siguiente corresponde a la contrasena local de ejemplo: admin
CORE_API_ADMIN_PASSWORD_HASH='$2y$12$bHJ7N8sdERYVjI0O7iG6auEi3LPGXk7zy.Nz.7KjueEnjZfnMPWEy'
CORE_API_JWT_SECRET=replace-with-a-long-random-jwt-secret
CORE_API_JWT_TTL_SECONDS=28800
CORE_API_REQUIRE_HTTPS=false
CORE_API_COOKIE_SECURE=false


# ------------------------------------------------------------------------------
# Semantic Service - FastAPI para busqueda semantica
# ------------------------------------------------------------------------------
SEMANTIC_SERVICE_HOST_PORT=8001
SEMANTIC_SERVICE_POSTGRES_DSN=postgresql://batch_downloader:batch_downloader@postgres:5432/batch_downloader_semantic


# ------------------------------------------------------------------------------
# Notification Service - Spring Boot
# ------------------------------------------------------------------------------
NOTIFICATION_SERVICE_SERVER_PORT=8080
NOTIFICATION_SERVICE_HOST_PORT=8083
NOTIFICATION_SERVICE_RABBITMQ_HOST=rabbitmq


# ------------------------------------------------------------------------------
# Download Worker - Spring Boot
# ------------------------------------------------------------------------------
DOWNLOAD_WORKER_SERVER_PORT=8080
DOWNLOAD_WORKER_HOST_PORT=8084
DOWNLOAD_WORKER_RABBITMQ_HOST=rabbitmq
DOWNLOAD_WORKER_MINIO_ENDPOINT=http://minio:9000
DOWNLOAD_WORKER_MINIO_ACCESS_KEY=batch_downloader
DOWNLOAD_WORKER_MINIO_SECRET_KEY=batch_downloader_secret


# ------------------------------------------------------------------------------
# Translation Service - Spring Boot + locales JSON
# ------------------------------------------------------------------------------
TRANSLATION_SERVICE_SERVER_PORT=8080
TRANSLATION_SERVICE_HOST_PORT=8085
TRANSLATION_SERVICE_LOCALES_PATH=/app/locales

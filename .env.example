# ==============================================================================
# Batch Downloader - configuracion global
# ==============================================================================
# Este archivo contiene exclusivamente configuracion compartida, puertos del
# host y valores sensibles o que deben personalizarse en cada despliegue.
# Los ajustes propios de cada API o servicio viven en su .env.example local.
# Copia este archivo a .env y cambia todas las credenciales antes de desplegar.
# ==============================================================================

# GitHub Container Registry
GHCR_REGISTRY=ghcr.io
GHCR_OWNER=joseleelsuper
GHCR_IMAGE_PREFIX=batch-downloader
GHCR_IMAGE_TAG=main

# MySQL
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=batch_downloader
MYSQL_USER=batch_downloader
MYSQL_PASSWORD=batch_downloader
MYSQL_HOST_PORT=3306

# PostgreSQL + pgvector
POSTGRES_DB=batch_downloader_semantic
POSTGRES_USER=batch_downloader
POSTGRES_PASSWORD=batch_downloader
POSTGRES_HOST_PORT=5432

# RabbitMQ
RABBITMQ_DEFAULT_USER=batch_downloader
RABBITMQ_DEFAULT_PASS=batch_downloader
RABBITMQ_HOST_PORT=5672
RABBITMQ_MANAGEMENT_HOST_PORT=15672
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_COMMAND_EXCHANGE=batch.commands.v1
RABBITMQ_EVENT_EXCHANGE=batch.events.v1

# MinIO
MINIO_ROOT_USER=batch_downloader
MINIO_ROOT_PASSWORD=batch_downloader_secret
MINIO_CORE_ACCESS_KEY=batch_core
MINIO_CORE_SECRET_KEY=change_core_minio_secret
MINIO_WORKER_ACCESS_KEY=batch_worker
MINIO_WORKER_SECRET_KEY=change_worker_minio_secret
MINIO_API_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001
MINIO_DOWNLOAD_HOST_PORT=9002
MINIO_ENDPOINT=http://minio:9000
# Desarrollo local. En producción debe ser el hostname HTTPS dedicado de descargas.
MINIO_PUBLIC_ENDPOINT=http://localhost:9002
MINIO_ZIP_BUCKET=zips
MINIO_ZIP_QUOTA=120GB
MINIO_REGION=us-east-1
MINIO_STALE_UPLOADS_EXPIRY=24h
MINIO_STALE_UPLOADS_CLEANUP_INTERVAL=1h

# Secretos y API keys compartidos con los servicios que los consumen
APP_PUBLIC_BASE_URL=http://localhost:3000
RESEND_API_KEY=
RESEND_FROM_EMAIL=
NOTIFICATION_TOKEN_ENCRYPTION_KEY=
SCRAPER_INTERNAL_SERVICE_TOKEN=
SCRAPER_URL_PROTECTION_SECRET=
SCRAPER_LLM_GROQ_API_KEY=
SCRAPER_LLM_DEEPSEEK_API_KEY=
# Core codifica esta contraseña con BCrypt antes de guardarla en la base de datos.
CORE_API_ADMIN_USERNAME=admin
CORE_API_ADMIN_EMAIL=admin@batch-downloader.local
CORE_API_ADMIN_PASSWORD=
CORE_API_DOWNLOAD_OWNER_SECRET=
NOTIFICATION_SERVICE_SMTP_USERNAME=
NOTIFICATION_SERVICE_SMTP_PASSWORD=

# Puertos publicados en el host
WEBAPP_HOST_PORT=3000
CORE_API_HOST_PORT=8081
SEMANTIC_SERVICE_HOST_PORT=8001
NOTIFICATION_SERVICE_HOST_PORT=8083
MAILPIT_SMTP_HOST_PORT=1025
MAILPIT_UI_HOST_PORT=8025
DOWNLOAD_WORKER_HOST_PORT=8084
TRANSLATION_SERVICE_HOST_PORT=8085

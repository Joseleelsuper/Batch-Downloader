# Plantilla versionada para Scraper Scheduler.
# Fuente versionada para generar el .env local del componente.
# La raiz .env/.env.example sigue siendo la fuente global de Docker Compose.
# Contrasenas, tokens, claves de firma y API keys se omiten deliberadamente.

SCRAPPER_APP_NAME=Batch Downloader Scraper
SCRAPPER_ENVIRONMENT=development
SCRAPPER_WINSTALL_BASE_URL=https://winstall.app
SCRAPPER_WINSTALL_API_BASE_URL=https://winstall.app/api/winstall
SCRAPPER_REQUEST_TIMEOUT_SECONDS=20
SCRAPPER_MAX_REDIRECTS=5
SCRAPPER_MAX_DOWNLOAD_SIZE_BYTES=1500000000
SCRAPPER_ICON_MAX_BYTES=5000000
SCRAPPER_MANUAL_INSPECTION_TTL_HOURS=24
SCRAPPER_MANUAL_INSPECTION_MAX_ATTEMPTS=4
SCRAPPER_MANUAL_PAGE_MAX_BYTES=1000000
SCRAPPER_SO_FILTER_CONCURRENCY=2
SCRAPPER_SO_FILTER_MAX_ATTEMPTS=4
SCRAPPER_SCRAPE_CONCURRENCY=6
SCRAPPER_CPU_THREAD_WORKERS=4
SCRAPPER_SCHEDULER_TIMEZONE=Europe/Madrid
SCRAPPER_SCHEDULER_HOUR=3
SCRAPPER_SCHEDULER_MINUTE=0
SCRAPPER_RUN_ON_STARTUP=false
SCRAPPER_ALLOWED_DOWNLOAD_SCHEMES=["https"]
SCRAPPER_SCRAPE_MAX_APPS=0
SCRAPPER_SCRAPE_APP_TIMEOUT_SECONDS=90
SCRAPPER_PLAYWRIGHT_TIMEOUT_MS=15000
SCRAPPER_LLM_GROQ_BASE_URL=https://api.groq.com/openai/v1
SCRAPPER_LLM_GROQ_MODEL=llama-3.1-8b-instant
SCRAPPER_LLM_GROQ_FALLBACK_MODELS=["llama-3.3-70b-versatile","qwen/qwen3-32b","qwen/qwen3.6-27b","meta-llama/llama-4-scout-17b-16e-instruct"]
SCRAPPER_LLM_DEEPSEEK_BASE_URL=https://api.deepseek.com
SCRAPPER_LLM_DEEPSEEK_MODEL=deepseek-v4-flash
SCRAPPER_LLM_MAX_CONCURRENCY=1
SCRAPPER_LLM_MAX_APPS_PER_RUN=0
SCRAPPER_LLM_REQUEST_TIMEOUT_SECONDS=45
SCRAPPER_DATABASE_POOL_MAX=1
SCRAPPER_DATABASE_MAX_OVERFLOW=0
SCRAPPER_DATABASE_POOL_TIMEOUT_SECONDS=2
SCRAPPER_DATABASE_POOL_RECYCLE_SECONDS=1500

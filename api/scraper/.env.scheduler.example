# Plantilla versionada para Scraper Scheduler.
# Fuente versionada para generar el .env local del componente.
# La raiz .env/.env.example sigue siendo la fuente global de Docker Compose.
# Contrasenas, tokens, claves de firma y API keys se omiten deliberadamente.

SCRAPER_APP_NAME=Batch Downloader Scraper
SCRAPER_WINSTALL_BASE_URL=https://winstall.app
SCRAPER_WINSTALL_API_BASE_URL=https://winstall.app/api/winstall
SCRAPER_REQUEST_TIMEOUT_SECONDS=20
SCRAPER_MAX_REDIRECTS=5
SCRAPER_MAX_DOWNLOAD_SIZE_BYTES=4000000000
SCRAPER_ICON_MAX_BYTES=5000000
SCRAPER_MANUAL_INSPECTION_TTL_HOURS=24
SCRAPER_MANUAL_INSPECTION_MAX_ATTEMPTS=4
SCRAPER_MANUAL_PAGE_MAX_BYTES=1000000
SCRAPER_SO_FILTER_CONCURRENCY=2
SCRAPER_SO_FILTER_MAX_ATTEMPTS=4
SCRAPER_SCRAPE_CONCURRENCY=6
SCRAPER_CPU_THREAD_WORKERS=4
SCRAPER_SCHEDULER_TIMEZONE=Europe/Madrid
SCRAPER_SCHEDULER_HOUR=3
SCRAPER_SCHEDULER_MINUTE=0
SCRAPER_RUN_ON_STARTUP=false
SCRAPER_WORKER_HEARTBEAT_INTERVAL_SECONDS=10
SCRAPER_WORKER_HEARTBEAT_STALE_SECONDS=45
SCRAPER_WORKER_FAILURE_THRESHOLD=3
SCRAPER_ALLOWED_DOWNLOAD_SCHEMES=["https"]
SCRAPER_SCRAPE_MAX_APPS=0
SCRAPER_SCRAPE_APP_TIMEOUT_SECONDS=90
SCRAPER_PLAYWRIGHT_TIMEOUT_MS=15000
SCRAPER_LLM_GROQ_BASE_URL=https://api.groq.com/openai/v1
SCRAPER_LLM_GROQ_MODEL=llama-3.1-8b-instant
SCRAPER_LLM_GROQ_FALLBACK_MODELS=["qwen/qwen3-32b","qwen/qwen3.6-27b","meta-llama/llama-4-scout-17b-16e-instruct"]
SCRAPER_LLM_DEEPSEEK_BASE_URL=https://api.deepseek.com
SCRAPER_LLM_DEEPSEEK_MODEL=deepseek-v4-flash
SCRAPER_LLM_MAX_CONCURRENCY=1
SCRAPER_LLM_MAX_APPS_PER_RUN=0
SCRAPER_LLM_REQUEST_TIMEOUT_SECONDS=45
SCRAPER_DATABASE_POOL_MAX=2
SCRAPER_DATABASE_MAX_OVERFLOW=0
SCRAPER_DATABASE_POOL_TIMEOUT_SECONDS=5
SCRAPER_DATABASE_POOL_RECYCLE_SECONDS=1500

# Copiar a /etc/batch-downloader/backup.env con permisos 0600.

# Variables vacías (orden alfabético).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
OCI_S3_REGION=
RESTIC_PASSWORD=

# Variables con valor (orden alfabético).
BATCH_BACKUP_RETENTION_SECONDS=86400
BATCH_COMPOSE_PROJECT=batch-downloader
OCI_BACKUP_BUCKET=batchdownloader-prod-backups
OCI_S3_ENDPOINT=https://NAMESPACE.compat.objectstorage.REGION.oraclecloud.com
SEMANTIC_MODELS_VOLUME_NAME=batch-downloader_semantic_models

# Plantilla versionada para Download Worker.
# Fuente versionada para generar el .env local del componente.
# La raiz .env/.env.example sigue siendo la fuente global de Docker Compose.
# Contrasenas, tokens, claves de firma y API keys se omiten deliberadamente.

DOWNLOAD_WORKER_SERVER_PORT=8080
DOWNLOAD_WORKER_INBOX_URL=jdbc:h2:file:/app/data/download-inbox;DB_CLOSE_ON_EXIT=FALSE
DOWNLOAD_WORKER_INBOX_USERNAME=sa
DOWNLOAD_WORKER_COMMAND_EXCHANGE=batch.commands.v1
DOWNLOAD_WORKER_EVENT_EXCHANGE=batch.events.v1
DOWNLOAD_WORKER_INPUT_ROUTING_KEY=download.job.requested
DOWNLOAD_WORKER_INPUT_QUEUE=download-worker.download.job.requested.v1
DOWNLOAD_WORKER_CANCELLATION_ROUTING_KEY=download.job.cancel-requested
DOWNLOAD_WORKER_SOURCE_RESOLVER_URL=http://scraper-api:8000
DOWNLOAD_WORKER_CORE_API_URL=http://core-api:8080
DOWNLOAD_WORKER_CANCELLATION_QUEUE=download-worker.download.job.cancel-requested.v1
DOWNLOAD_WORKER_DLX=batch.dead-letter.v1
DOWNLOAD_WORKER_DLQ=download-worker.download.job.requested.v1.dlq
DOWNLOAD_WORKER_RETRY_ATTEMPTS=3
DOWNLOAD_WORKER_RETRY_INITIAL_INTERVAL=1s
DOWNLOAD_WORKER_RETRY_MULTIPLIER=2.0
DOWNLOAD_WORKER_RETRY_MAX_INTERVAL=10s
DOWNLOAD_WORKER_PRESIGNED_TTL=24h
DOWNLOAD_WORKER_SOURCE_RESOLVER_TIMEOUT=10s
DOWNLOAD_WORKER_CORE_API_TIMEOUT=10s
DOWNLOAD_WORKER_MAX_ITEMS=100
DOWNLOAD_WORKER_MAX_FILE_SIZE=4GB
DOWNLOAD_WORKER_MAX_TOTAL_SIZE=20GB
DOWNLOAD_WORKER_MAX_REDIRECTS=5
DOWNLOAD_WORKER_CONNECT_TIMEOUT=10s
DOWNLOAD_WORKER_REQUEST_TIMEOUT=15m
DOWNLOAD_WORKER_CONCURRENCY=8
DOWNLOAD_WORKER_JOB_CONCURRENCY=2
DOWNLOAD_WORKER_PER_JOB_CONCURRENCY=4
DOWNLOAD_WORKER_PACKAGING_CONCURRENCY=1
DOWNLOAD_WORKER_ZIP_LEVEL=1
DOWNLOAD_WORKER_MIN_FREE_SPACE=10GB
DOWNLOAD_WORKER_LARGE_JOB_THRESHOLD=2GB
DOWNLOAD_WORKER_MULTIPART_PART_SIZE=16MB
DOWNLOAD_WORKER_INBOX_LEASE=30m
DOWNLOAD_WORKER_TEMP_DIRECTORY=/tmp/batch-downloader

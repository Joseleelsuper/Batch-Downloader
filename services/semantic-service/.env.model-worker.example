# Plantilla versionada para Semantic Model Worker.
# Fuente versionada para generar el .env local del componente.
# La raiz .env/.env.example sigue siendo la fuente global de Docker Compose.
# Contrasenas, tokens, claves de firma y API keys se omiten deliberadamente.

SEMANTIC_DEVICE=cpu
SEMANTIC_INITIAL_MODEL_VERSION=multilingual-e5-base@d128750597153bb5987e10b1c3493a34e5a4502a:zero-shot
SEMANTIC_CANDIDATE_LIMIT=20000
SEMANTIC_MINIMUM_SIMILARITY=0.82
SEMANTIC_INDEX_BATCH_SIZE=32
SEMANTIC_INDEX_INTERVAL_SECONDS=300
SEMANTIC_INDEX_LEASE_SECONDS=900
SEMANTIC_SEARCH_TIMEOUT_SECONDS=3
SEMANTIC_API_DB_POOL_MIN=1
SEMANTIC_API_DB_POOL_MAX=3
SEMANTIC_INDEXER_DB_POOL_MIN=0
SEMANTIC_INDEXER_DB_POOL_MAX=1
SEMANTIC_MODEL_WORKER_DB_POOL_MIN=0
SEMANTIC_MODEL_WORKER_DB_POOL_MAX=1
SEMANTIC_DB_POOL_TIMEOUT_SECONDS=2
SEMANTIC_DB_POOL_MAX_LIFETIME_SECONDS=1500
SEMANTIC_SEARCH_CONCURRENCY=2
SEMANTIC_SEARCH_CAPACITY_WAIT_SECONDS=2
SEMANTIC_BACKGROUND_TIMEZONE=Europe/Madrid
SEMANTIC_BACKGROUND_START_HOUR=1
SEMANTIC_BACKGROUND_END_HOUR=7
SEMANTIC_OPERATION_POLL_SECONDS=2
SEMANTIC_OPERATION_LEASE_SECONDS=300
SEMANTIC_RETENTION_INTERVAL_SECONDS=21600
SEMANTIC_WORKER_HEARTBEAT_INTERVAL_SECONDS=10
SEMANTIC_WORKER_HEARTBEAT_STALE_SECONDS=45
SEMANTIC_WORKER_FAILURE_THRESHOLD=3
SEMANTIC_MODEL_MAX_BYTES=16106127360
SEMANTIC_MODEL_MIN_FREE_BYTES=10737418240
SEMANTIC_TRAINER_SEED=20260723
SEMANTIC_TRAINER_EPOCHS=1
SEMANTIC_TRAINER_BATCH_SIZE=8
SEMANTIC_TRAINER_MAX_STEPS=-1
SEMANTIC_TRAINER_MODELS=["paraphrase-multilingual-MiniLM-L12-v2","multilingual-e5-base","bge-m3"]
SEMANTIC_DATABASE_ROLE=model_worker

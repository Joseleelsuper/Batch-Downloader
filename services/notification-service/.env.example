# Plantilla versionada para Notification Service.
# Fuente versionada para generar el .env local del componente.
# La raiz .env/.env.example sigue siendo la fuente global de Docker Compose.
# Contrasenas, tokens, claves de firma y API keys se omiten deliberadamente.

NOTIFICATION_SERVICE_SERVER_PORT=8080
NOTIFICATION_RETRY_MAX_ATTEMPTS=3
NOTIFICATION_RETRY_INITIAL_INTERVAL=1s
NOTIFICATION_RETRY_MULTIPLIER=2
NOTIFICATION_RETRY_MAX_INTERVAL=10s
NOTIFICATION_SERVICE_INBOX_URL=jdbc:h2:file:/app/data/notification-inbox;DB_CLOSE_ON_EXIT=FALSE
NOTIFICATION_SERVICE_INBOX_USERNAME=sa
NOTIFICATION_SERVICE_INBOX_LEASE_DURATION=PT5M
NOTIFICATION_SERVICE_SMTP_HOST=mailpit
NOTIFICATION_SERVICE_SMTP_PORT=1025
NOTIFICATION_SERVICE_SMTP_AUTH=false
NOTIFICATION_SERVICE_SMTP_STARTTLS=false
NOTIFICATION_SERVICE_SMTP_CONNECTION_TIMEOUT_MS=5000
NOTIFICATION_SERVICE_SMTP_TIMEOUT_MS=10000
NOTIFICATION_SERVICE_SMTP_WRITE_TIMEOUT_MS=10000
NOTIFICATION_SERVICE_MAIL_FROM=no-reply@batch-downloader.local
NOTIFICATION_SERVICE_MAIL_ZONE_ID=Europe/Madrid
NOTIFICATION_SERVICE_PUBLIC_BASE_URL=http://localhost:3000

# Plantilla versionada para Core API.
# Fuente versionada para generar el .env local del componente.
# La raiz .env/.env.example sigue siendo la fuente global de Docker Compose.
# Contrasenas, tokens, claves de firma y API keys se omiten deliberadamente.

CORE_API_SERVER_PORT=8080
CORE_API_SCRAPER_API_URL=http://scraper-api:8000
CORE_API_SEMANTIC_SERVICE_URL=http://semantic-service:8000
CORE_API_DOWNLOAD_WORKER_URL=http://download-worker:8080
CORE_API_DOWNLOAD_WORKER_CAPACITY_TIMEOUT=1s
CORE_API_SEMANTIC_REQUEST_TIMEOUT=3s
CORE_API_SEMANTIC_ADMIN_REQUEST_TIMEOUT=30s
CORE_API_BCRYPT_STRENGTH=12
CORE_API_DB_POOL_MIN=2
CORE_API_DB_POOL_MAX=5
CORE_API_DB_POOL_TIMEOUT=2000
CORE_API_AUTH_HASH_CONCURRENCY=2
CORE_API_AUTH_HASH_QUEUE=20
CORE_API_AUTH_HASH_WAIT=2s
CORE_API_AUTH_LOGIN_MAX_PER_MINUTE=10
CORE_API_AUTH_REGISTER_MAX_PER_HOUR=3
CORE_API_AUTH_RESET_MAX_PER_HOUR=3
CORE_API_SESSION_TIMEOUT=8h
CORE_API_VERIFICATION_TTL=24h
CORE_API_OUTBOX_DELAY=1s
CORE_API_OUTBOX_CLAIM_LEASE=5m
CORE_API_OUTBOX_CONFIRM_TIMEOUT=2s
CORE_API_JWT_TTL_SECONDS=28800
CORE_API_REQUIRE_HTTPS=false
CORE_API_COOKIE_SECURE=false
DOWNLOAD_MAX_APPS=100
DOWNLOAD_ZIP_RETENTION=24h
DOWNLOAD_PRESIGNED_URL_TTL=5m
DOWNLOAD_ANONYMOUS_MAX_ACTIVE_JOBS=2
DOWNLOAD_ANONYMOUS_MAX_CREATES_PER_HOUR=10
DOWNLOAD_ANONYMOUS_MAX_CREATES_PER_IP_HOUR=30
DOWNLOAD_AUTHENTICATED_MAX_ACTIVE_JOBS=3
DOWNLOAD_GLOBAL_MAX_PENDING_JOBS=100
DOWNLOAD_SSE_HEARTBEAT=20s
CORE_API_CATALOG_CACHE_MAXIMUM_SIZE=512
CORE_API_CATALOG_CACHE_TTL=15s
CORE_API_DOWNLOAD_EVENTS_QUEUE=core-api.download.events.v1

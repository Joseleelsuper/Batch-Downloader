# Plantilla versionada para Translation Service.
# Fuente versionada para generar el .env local del componente.
# La raiz .env/.env.example sigue siendo la fuente global de Docker Compose.
# Contrasenas, tokens, claves de firma y API keys se omiten deliberadamente.

TRANSLATION_SERVICE_SERVER_PORT=8080
TRANSLATION_SERVICE_LOCALES_PATH=/app/locales
TRANSLATION_SERVICE_CACHE_MAX_AGE=PT1H

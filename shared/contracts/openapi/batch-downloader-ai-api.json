{
  "openapi": "3.1.0",
  "info": {
    "title": "Batch Downloader API de lectura para IA",
    "version": "1.0.0",
    "description": "Consultas anónimas del catálogo de aplicaciones y de bundles públicos u oficiales. Solo lectura, sin sesión, cookies ni token CSRF.",
    "license": {
      "name": "GPL-3.0-only",
      "identifier": "GPL-3.0-only"
    }
  },
  "servers": [
    {
      "url": "https://batchdownloader.dev/api/v1"
    }
  ],
  "security": [],
  "paths": {
    "/apps": {
      "get": {
        "operationId": "searchApps",
        "summary": "Buscar aplicaciones del catálogo",
        "security": [],
        "parameters": [
          {
            "$ref": "#/components/parameters/Page"
          },
          {
            "$ref": "#/components/parameters/PageSize"
          },
          {
            "name": "query",
            "in": "query",
            "schema": {
              "type": "string",
              "maxLength": 180
            }
          },
          {
            "name": "searchMode",
            "in": "query",
            "description": "El valor omitido conserva la búsqueda literal para clientes existentes.",
            "schema": {
              "$ref": "#/components/schemas/SearchMode",
              "default": "lexical"
            }
          },
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "all",
                "available",
                "review",
                "missing"
              ],
              "default": "all"
            }
          },
          {
            "name": "os",
            "in": "query",
            "style": "form",
            "explode": true,
            "schema": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "enum": [
                  "windows",
                  "linux",
                  "macos"
                ]
              }
            }
          },
          {
            "name": "architecture",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "tag",
            "in": "query",
            "description": "Puede repetirse; la aplicación debe contener todas las tags indicadas.",
            "style": "form",
            "explode": true,
            "schema": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string"
              }
            }
          },
          {
            "name": "publisher",
            "in": "query",
            "description": "Editor único que debe coincidir con la aplicación.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "sort",
            "in": "query",
            "description": "Orden principal; relevance prioriza la similitud semántica dentro del umbral en modo semantic, la coincidencia textual en modo lexical y las descargas sin consulta. Los demás órdenes conservan su prioridad incluso al buscar.",
            "schema": {
              "type": "string",
              "enum": [
                "name",
                "updated",
                "downloads",
                "relevance"
              ],
              "default": "name"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Página de aplicaciones.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AppPage"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          }
        }
      }
    },
    "/apps/facets": {
      "get": {
        "operationId": "getCatalogFacets",
        "summary": "Consultar facetas del catálogo filtrado",
        "security": [],
        "parameters": [
          {
            "name": "query",
            "in": "query",
            "schema": {
              "type": "string",
              "maxLength": 180
            }
          },
          {
            "name": "searchMode",
            "in": "query",
            "description": "Aplica la misma enumeración híbrida que la página de aplicaciones.",
            "schema": {
              "$ref": "#/components/schemas/SearchMode",
              "default": "lexical"
            }
          },
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "all",
                "available",
                "review",
                "missing"
              ],
              "default": "all"
            }
          },
          {
            "name": "os",
            "in": "query",
            "style": "form",
            "explode": true,
            "schema": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "enum": [
                  "windows",
                  "linux",
                  "macos"
                ]
              }
            }
          },
          {
            "name": "architecture",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "tag",
            "in": "query",
            "description": "Puede repetirse; las facetas se calculan sobre aplicaciones que contienen todas las tags indicadas.",
            "style": "form",
            "explode": true,
            "schema": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string"
              }
            }
          },
          {
            "name": "publisher",
            "in": "query",
            "description": "Editor único aplicado también al cálculo de tags y editores disponibles.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Tags y editores de las aplicaciones que cumplen conjuntamente búsqueda, estado, SO, arquitectura, tags y editor.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CatalogFacets"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          }
        }
      }
    },
    "/apps/stats": {
      "get": {
        "operationId": "getCatalogStats",
        "summary": "Consultar estadísticas del catálogo",
        "security": [],
        "responses": {
          "200": {
            "description": "Estadísticas del catálogo.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CatalogStats"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          }
        }
      }
    },
    "/apps/{appId}": {
      "get": {
        "operationId": "getApp",
        "summary": "Consultar una aplicación",
        "security": [],
        "parameters": [
          {
            "$ref": "#/components/parameters/AppId"
          }
        ],
        "responses": {
          "200": {
            "description": "Detalle de la aplicación.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AppDetails"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/bundles": {
      "get": {
        "operationId": "listBundles",
        "summary": "Listar bundles públicos u oficiales",
        "security": [],
        "parameters": [
          {
            "$ref": "#/components/parameters/Page"
          },
          {
            "$ref": "#/components/parameters/PageSize"
          },
          {
            "name": "type",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "official",
                "community",
                "user",
                "public"
              ]
            }
          },
          {
            "name": "sort",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "updated",
                "stars",
                "downloads",
                "name",
                "relevance"
              ]
            }
          },
          {
            "name": "query",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "searchMode",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "lexical",
                "semantic"
              ],
              "default": "lexical"
            }
          },
          {
            "name": "creator",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "tag",
            "in": "query",
            "style": "form",
            "explode": true,
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          {
            "name": "os",
            "in": "query",
            "style": "form",
            "explode": true,
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "windows",
                  "linux",
                  "macos"
                ]
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Página de bundles visibles públicamente.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BundleCatalogPage"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          }
        }
      }
    },
    "/bundles/catalog/facets": {
      "get": {
        "operationId": "getBundleFacets",
        "summary": "Consultar etiquetas y creadores de bundles visibles",
        "security": [],
        "parameters": [
          {
            "name": "type",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "official",
                "community",
                "public",
                "user"
              ]
            }
          },
          {
            "name": "query",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "searchMode",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "lexical",
                "semantic"
              ],
              "default": "lexical"
            }
          },
          {
            "name": "creator",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "tag",
            "in": "query",
            "style": "form",
            "explode": true,
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          {
            "name": "os",
            "in": "query",
            "style": "form",
            "explode": true,
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "windows",
                  "linux",
                  "macos"
                ]
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Facetas compatibles con la búsqueda y filtros.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BundleFacets"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          }
        }
      }
    },
    "/bundles/{bundleId}": {
      "get": {
        "operationId": "getBundle",
        "summary": "Consultar un bundle público u oficial",
        "security": [],
        "parameters": [
          {
            "name": "bundleId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Detalle completo del bundle.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Bundle"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    }
  },
  "components": {
    "responses": {
      "NotFound": {
        "description": "Recurso no encontrado.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      },
      "BadRequest": {
        "description": "Entrada no válida.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      }
    },
    "schemas": {
      "Problem": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "message",
          "details"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "details": {
            "type": "object",
            "additionalProperties": true
          }
        }
      },
      "Bundle": {
        "allOf": [
          {
            "$ref": "#/components/schemas/BundleSummary"
          },
          {
            "type": "object",
            "required": [
              "apps"
            ],
            "properties": {
              "apps": {
                "type": "array",
                "maxItems": 100,
                "items": {
                  "$ref": "#/components/schemas/App"
                }
              }
            }
          }
        ]
      },
      "App": {
        "type": "object",
        "required": [
          "id",
          "slug",
          "packageId",
          "name",
          "tags",
          "operatingSystems",
          "downloadable",
          "updatedAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "slug": {
            "type": "string"
          },
          "packageId": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "publisher": {
            "type": [
              "string",
              "null"
            ]
          },
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "longDescription": {
            "type": [
              "string",
              "null"
            ]
          },
          "longDescriptionEn": {
            "type": [
              "string",
              "null"
            ]
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "operatingSystems": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "enum": [
                "windows",
                "linux",
                "macos"
              ]
            }
          },
          "iconUrl": {
            "type": [
              "string",
              "null"
            ],
            "format": "uri"
          },
          "latestVersion": {
            "type": [
              "string",
              "null"
            ]
          },
          "sourceLabel": {
            "type": "string"
          },
          "resolutionStatus": {
            "type": "string"
          },
          "validationStatus": {
            "type": "string"
          },
          "downloadable": {
            "description": "Indica que la aplicación puede incorporarse a un trabajo; la URL se revalida justo antes de descargar.",
            "type": "boolean"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "BundleSummary": {
        "type": "object",
        "required": [
          "id",
          "slug",
          "name",
          "type",
          "visibility",
          "starCount",
          "starred",
          "hasAdminStar",
          "downloadCount",
          "appCount",
          "operatingSystems",
          "platformAvailability",
          "tags",
          "previewApps",
          "updatedAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "slug": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "creatorUsername": {
            "description": "Nombre de usuario actual del creador, si la cuenta sigue asociada al bundle.",
            "type": [
              "string",
              "null"
            ]
          },
          "type": {
            "type": "string",
            "enum": [
              "official",
              "community",
              "user"
            ]
          },
          "visibility": {
            "type": "string",
            "enum": [
              "official",
              "public",
              "private"
            ]
          },
          "starCount": {
            "type": "integer"
          },
          "starred": {
            "type": "boolean",
            "description": "Indica si la cuenta actual ha dado estrella; false para visitantes o bundles privados."
          },
          "hasAdminStar": {
            "type": "boolean",
            "description": "Existe al menos una estrella de una cuenta administradora activa."
          },
          "downloadCount": {
            "type": "integer",
            "minimum": 0,
            "description": "ZIP recibidos completamente, contados una vez por trabajo desde la activación del contador."
          },
          "appCount": {
            "type": "integer"
          },
          "operatingSystems": {
            "description": "Sistemas con un instalador seleccionable para al menos una aplicación activa del bundle. Al crear un trabajo para un sistema, se omiten las aplicaciones sin fuente compatible.",
            "type": "array",
            "maxItems": 3,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "enum": [
                "windows",
                "linux",
                "macos"
              ]
            }
          },
          "platformAvailability": {
            "type": "array",
            "maxItems": 3,
            "uniqueItems": true,
            "items": {
              "$ref": "#/components/schemas/BundlePlatformAvailability"
            }
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "previewApps": {
            "type": "array",
            "maxItems": 6,
            "items": {
              "$ref": "#/components/schemas/App"
            }
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "BundlePlatformAvailability": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "operatingSystem",
          "downloadableAppCount",
          "previewApps"
        ],
        "properties": {
          "operatingSystem": {
            "type": "string",
            "enum": [
              "windows",
              "linux",
              "macos"
            ]
          },
          "downloadableAppCount": {
            "type": "integer",
            "minimum": 1
          },
          "previewApps": {
            "type": "array",
            "maxItems": 6,
            "items": {
              "$ref": "#/components/schemas/App"
            }
          }
        }
      },
      "BundleFacets": {
        "type": "object",
        "required": [
          "tags",
          "creators"
        ],
        "properties": {
          "tags": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BundleFacet"
            }
          },
          "creators": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BundleFacet"
            }
          }
        }
      },
      "BundleFacet": {
        "type": "object",
        "required": [
          "value",
          "label",
          "letter",
          "count"
        ],
        "properties": {
          "value": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "letter": {
            "type": "string"
          },
          "count": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "BundleCatalogPage": {
        "type": "object",
        "required": [
          "data",
          "page",
          "pageSize",
          "total"
        ],
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BundleSummary"
            }
          },
          "page": {
            "type": "integer"
          },
          "pageSize": {
            "type": "integer"
          },
          "total": {
            "type": "integer",
            "format": "int64"
          },
          "counts": {
            "type": "object",
            "properties": {
              "all": {
                "type": "integer",
                "minimum": 0
              },
              "public": {
                "type": "integer",
                "minimum": 0
              },
              "official": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "alphabet": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "letter",
                "page",
                "count"
              ],
              "properties": {
                "letter": {
                  "type": "string"
                },
                "page": {
                  "type": "integer",
                  "minimum": 1
                },
                "count": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          },
          "requestedMode": {
            "type": [
              "string",
              "null"
            ]
          },
          "appliedMode": {
            "type": [
              "string",
              "null"
            ]
          },
          "modelVersion": {
            "type": [
              "string",
              "null"
            ]
          },
          "indexVersion": {
            "type": [
              "string",
              "null"
            ]
          },
          "degradedReason": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "AppDetails": {
        "allOf": [
          {
            "$ref": "#/components/schemas/App"
          },
          {
            "type": "object",
            "required": [
              "originUrl",
              "downloadOptions",
              "notes"
            ],
            "properties": {
              "officialUrl": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "uri"
              },
              "originUrl": {
                "type": "string",
                "format": "uri"
              },
              "installerFilename": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "installerType": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "contentType": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "sizeBytes": {
                "type": [
                  "integer",
                  "null"
                ],
                "format": "int64"
              },
              "finalDomain": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "score": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "checkedAt": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "date-time"
              },
              "expiresAt": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "date-time"
              },
              "downloadOptions": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/DownloadOption"
                }
              },
              "notes": {
                "type": "string"
              }
            }
          }
        ]
      },
      "DownloadOption": {
        "type": "object",
        "required": [
          "id",
          "operatingSystem",
          "architecture",
          "isLatest",
          "sourceLabel",
          "score",
          "isPrimary"
        ],
        "properties": {
          "installationSupport": {
            "type": "string",
            "enum": [
              "automatic",
              "manual",
              "not_applicable"
            ]
          },
          "compatibleLinuxTargets": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LinuxTarget"
            }
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "filename": {
            "type": [
              "string",
              "null"
            ]
          },
          "extension": {
            "type": [
              "string",
              "null"
            ]
          },
          "operatingSystem": {
            "type": "string"
          },
          "architecture": {
            "type": "string"
          },
          "version": {
            "type": [
              "string",
              "null"
            ]
          },
          "isLatest": {
            "type": "boolean"
          },
          "versionStatus": {
            "type": [
              "string",
              "null"
            ]
          },
          "sourceLabel": {
            "type": "string"
          },
          "score": {
            "type": "integer"
          },
          "finalDomain": {
            "type": [
              "string",
              "null"
            ]
          },
          "isPrimary": {
            "type": "boolean"
          }
        }
      },
      "LinuxTarget": {
        "description": "Familia de paquetes del equipo de destino; solo para selección exclusivamente Linux.",
        "type": "string",
        "enum": [
          "apt",
          "dnf",
          "pacman",
          "zypper",
          "portable"
        ]
      },
      "CatalogStats": {
        "type": "object",
        "required": [
          "total",
          "filters",
          "generatedAt"
        ],
        "properties": {
          "total": {
            "type": "integer",
            "format": "int64"
          },
          "filters": {
            "type": "object",
            "required": [
              "all",
              "available",
              "review",
              "missing"
            ],
            "properties": {
              "all": {
                "type": "integer",
                "format": "int64"
              },
              "available": {
                "type": "integer",
                "format": "int64"
              },
              "review": {
                "type": "integer",
                "format": "int64"
              },
              "missing": {
                "type": "integer",
                "format": "int64"
              }
            }
          },
          "generatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "CatalogFacets": {
        "type": "object",
        "required": [
          "tags",
          "publishers",
          "requestedMode",
          "appliedMode"
        ],
        "properties": {
          "tags": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FacetItem"
            }
          },
          "publishers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FacetItem"
            }
          },
          "requestedMode": {
            "$ref": "#/components/schemas/SearchMode"
          },
          "appliedMode": {
            "$ref": "#/components/schemas/SearchMode"
          },
          "modelVersion": {
            "type": [
              "string",
              "null"
            ]
          },
          "indexVersion": {
            "type": [
              "string",
              "null"
            ]
          },
          "degradedReason": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "SearchMode": {
        "type": "string",
        "enum": [
          "lexical",
          "semantic"
        ]
      },
      "FacetItem": {
        "type": "object",
        "required": [
          "label",
          "value",
          "normalizedValue",
          "letter",
          "count"
        ],
        "properties": {
          "label": {
            "type": "string"
          },
          "value": {
            "type": "string"
          },
          "normalizedValue": {
            "type": "string"
          },
          "letter": {
            "type": "string"
          },
          "count": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "AppPage": {
        "type": "object",
        "required": [
          "data",
          "page",
          "pageSize",
          "total",
          "alphabet",
          "requestedMode",
          "appliedMode"
        ],
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/App"
            }
          },
          "page": {
            "type": "integer"
          },
          "pageSize": {
            "type": "integer"
          },
          "total": {
            "type": "integer",
            "format": "int64"
          },
          "requestedMode": {
            "$ref": "#/components/schemas/SearchMode"
          },
          "appliedMode": {
            "$ref": "#/components/schemas/SearchMode"
          },
          "modelVersion": {
            "type": [
              "string",
              "null"
            ]
          },
          "indexVersion": {
            "type": [
              "string",
              "null"
            ]
          },
          "degradedReason": {
            "description": "Motivo estable de degradación de la búsqueda semántica; por ejemplo, `semantic_query_too_short` cuando el servicio rechaza una consulta demasiado corta.",
            "type": [
              "string",
              "null"
            ]
          },
          "alphabet": {
            "type": "array",
            "description": "Letras disponibles con página inicial y número de aplicaciones para los filtros actuales.",
            "items": {
              "$ref": "#/components/schemas/CatalogAlphabetEntry"
            }
          }
        }
      },
      "CatalogAlphabetEntry": {
        "type": "object",
        "required": [
          "letter",
          "page",
          "count"
        ],
        "properties": {
          "letter": {
            "type": "string",
            "description": "Inicial normalizada; los nombres sin una letra latina se agrupan en '#'."
          },
          "page": {
            "type": "integer",
            "minimum": 1,
            "description": "Primera página de esa inicial con el tamaño de página solicitado."
          },
          "count": {
            "type": "integer",
            "format": "int64",
            "minimum": 0,
            "description": "Aplicaciones que pertenecen a esa inicial tras aplicar los filtros."
          }
        }
      }
    },
    "parameters": {
      "PageSize": {
        "name": "pageSize",
        "in": "query",
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 20
        }
      },
      "Page": {
        "name": "page",
        "in": "query",
        "schema": {
          "type": "integer",
          "minimum": 1,
          "default": 1
        }
      },
      "AppId": {
        "name": "appId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string"
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://batch-downloader.local/schemas/notification-requested.json",
  "title": "notification.email.requested.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["eventId", "type", "schemaVersion", "occurredAt", "correlationId", "payload"],
  "properties": {
    "eventId": { "type": "string", "format": "uuid" },
    "type": { "const": "notification.email.requested" },
    "schemaVersion": { "const": 1 },
    "occurredAt": { "type": "string", "format": "date-time" },
    "correlationId": { "type": "string" },
    "causationId": { "type": ["string", "null"] },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recipient", "template", "parameters"],
      "properties": {
        "recipient": { "type": "string", "format": "email" },
        "locale": {
          "type": "string",
          "pattern": "^[A-Za-z]{2,12}(?:[-_][A-Za-z0-9]{2,12})*$"
        },
        "template": { "enum": ["MAGIC_LINK"] },
        "parameters": {
          "type": "object",
          "description": "Parámetros de plantilla. token usa AES-GCM enc:v2: autenticado con recipient y template; se rechazan texto claro y sobres enc:v1: sin contexto.",
          "required": ["token"],
          "additionalProperties": { "type": ["string", "number", "boolean"] },
          "properties": {
            "token": { "type": "string", "pattern": "^enc:v2:" },
            "expiresInMinutes": { "type": "integer", "minimum": 1 }
          }
        }
      }
    }
  }
}

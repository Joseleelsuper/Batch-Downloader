{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://batch-downloader.local/schemas/source-resolved.json",
  "title": "SourceResolvedEvent",
  "type": "object",
  "additionalProperties": false,
  "required": ["eventId", "type", "schemaVersion", "occurredAt", "correlationId", "causationId", "payload"],
  "properties": {
    "eventId": { "type": "string", "format": "uuid" },
    "type": { "const": "catalog.source.resolved" },
    "schemaVersion": { "const": 1 },
    "occurredAt": { "type": "string", "format": "date-time" },
    "correlationId": { "type": "string", "format": "uuid" },
    "causationId": { "type": ["string", "null"], "format": "uuid" },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceRef", "appId", "status"],
      "properties": {
        "sourceRef": { "type": "string", "format": "uuid" },
        "appId": { "type": "string", "format": "uuid" },
        "status": { "enum": ["VERIFIED", "ATTESTED", "REJECTED", "UNRESOLVED"] },
        "artifactFormat": { "type": ["string", "null"] },
        "platform": { "type": ["string", "null"] },
        "architecture": { "enum": ["X86", "X86_64", "ARM64", "UNIVERSAL", "UNKNOWN", null] },
        "sizeBytes": { "type": ["integer", "null"], "minimum": 0 },
        "sha256": { "type": ["string", "null"], "pattern": "^[a-fA-F0-9]{64}$" }
      }
    }
  }
}

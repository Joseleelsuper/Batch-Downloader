{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://batch-downloader.local/schemas/download-job-failed.json",
  "title": "download.job.failed.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["eventId", "type", "schemaVersion", "occurredAt", "correlationId", "payload"],
  "properties": {
    "eventId": { "type": "string", "format": "uuid" },
    "type": { "const": "download.job.failed" },
    "schemaVersion": { "const": 1 },
    "occurredAt": { "type": "string", "format": "date-time" },
    "correlationId": { "type": "string" },
    "causationId": { "type": ["string", "null"] },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["jobId", "errorCode"],
      "properties": {
        "jobId": { "type": "string", "format": "uuid" },
        "errorCode": { "type": "string" },
        "failedItems": { "type": "integer", "minimum": 1 }
      }
    }
  }
}

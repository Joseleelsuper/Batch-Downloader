{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://batch-downloader.local/schemas/zip-generated.json",
  "title": "download.job.ready.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["eventId", "type", "schemaVersion", "occurredAt", "correlationId", "payload"],
  "properties": {
    "eventId": { "type": "string", "format": "uuid" },
    "type": { "const": "download.job.ready" },
    "schemaVersion": { "const": 1 },
    "occurredAt": { "type": "string", "format": "date-time" },
    "correlationId": { "type": "string" },
    "causationId": { "type": ["string", "null"] },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["jobId", "status", "objectKey", "sizeBytes", "sha256", "successfulItems", "failedItems", "expiresAt"],
      "properties": {
        "jobId": { "type": "string", "format": "uuid" },
        "status": { "enum": ["READY", "PARTIAL", "MANUAL_ONLY"] },
        "objectKey": { "type": "string", "minLength": 1 },
        "sizeBytes": { "type": "integer", "minimum": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "successfulItems": { "type": "integer", "minimum": 0 },
        "failedItems": { "type": "integer", "minimum": 0 },
        "expiresAt": { "type": "string", "format": "date-time" }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "MANUAL_ONLY" } }, "required": ["status"] },
          "then": {
            "properties": {
              "successfulItems": { "const": 0 },
              "failedItems": { "minimum": 1 }
            }
          },
          "else": {
            "properties": {
              "successfulItems": { "minimum": 1 }
            }
          }
        },
        {
          "if": { "properties": { "status": { "const": "READY" } }, "required": ["status"] },
          "then": { "properties": { "failedItems": { "const": 0 } } }
        },
        {
          "if": { "properties": { "status": { "const": "PARTIAL" } }, "required": ["status"] },
          "then": { "properties": { "failedItems": { "minimum": 1 } } }
        }
      ]
    }
  }
}
